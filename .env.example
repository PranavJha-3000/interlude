# Neon Postgres, Singapore (ap-southeast-1).
#
# Two URLs, and the difference matters:
#   DATABASE_URL — POOLED   (hostname contains "-pooler"). Used at runtime.
#                            Serverless opens a connection per invocation and
#                            would exhaust a direct connection limit under the
#                            polling load this product generates.
#   DIRECT_URL   — UNPOOLED (no "-pooler"). Used only by prisma migrate.
#                            The migration engine needs a real session; a
#                            transaction-mode pooler breaks its advisory locks.
#
# The pooled hostname is the direct one with "-pooler" appended to the endpoint
# id, before the first dot.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Signs guest session cookies, staff PIN sessions and operator sessions.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs everyone out, which is the intended effect.
SESSION_SECRET=""

# Public origin. Builds the QR URLs on the printed table tents, the venue QR,
# and the absolute magic-link URL that goes into a sign-in email.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Outbound email, for operator sign-in links (SECURITY.md §7).
#
# BOTH ARE OPTIONAL IN DEVELOPMENT. With no RESEND_API_KEY there is no network
# call and no key on your laptop — the sign-in link is printed to the console
# you ran `npm run dev` in. Onboarding is fully testable without either.
RESEND_API_KEY=""
EMAIL_FROM="Interlude <signin@yourdomain.com>"

# Optional: the address the seed attaches to the pilot venue as its owner.
SEED_OPERATOR_EMAIL="owner@example.com"
