# Postgres. Neon in production; any Postgres works locally.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs guest session cookies and staff PIN sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public origin, used to build QR URLs for the printed table tents.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
