# Neon Postgres, Singapore (ap-southeast-1).
#
# Two URLs, and the difference matters:
#   DATABASE_URL — POOLED   (hostname contains "-pooler"). Used at runtime.
#                            Serverless opens a connection per invocation and
#                            would exhaust a direct connection limit under the
#                            polling load this product generates.
#   DIRECT_URL   — UNPOOLED (no "-pooler"). Used only by prisma migrate.
#                            The migration engine needs a real session; a
#                            transaction-mode pooler breaks its advisory locks.
#
# The pooled hostname is the direct one with "-pooler" appended to the endpoint
# id, before the first dot.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Signs guest session cookies, staff PIN sessions and operator sessions.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs everyone out, which is the intended effect.
SESSION_SECRET=""

# Public origin. Builds the QR URLs on the printed table tents, the venue QR,
# and the absolute magic-link URL that goes into a sign-in email.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Outbound email, for operator sign-in links (SECURITY.md §7).
#
# BOTH ARE OPTIONAL IN DEVELOPMENT. With no RESEND_API_KEY there is no network
# call and no key on your laptop — the sign-in link is printed to the console
# you ran `npm run dev` in. Onboarding is fully testable without either.
#
# BOTH ARE REQUIRED IN A DEPLOYED BUILD. Without them the sign-in page still
# says "check your email" and nothing is sent, which locks every operator out
# with no error anywhere to say why — so a production build refuses to start a
# send instead. EMAIL_FROM's domain must be verified in Resend; an unverified
# one is rejected with a 403, and until you verify one Resend will only deliver
# to the address that owns the account.
RESEND_API_KEY=""
EMAIL_FROM="Interlude <signin@yourdomain.com>"

# Waives that refusal, for the one case that earns it: the E2E suite runs a
# production build with no key on purpose. Never set this on a deployment —
# it re-arms the silent outage the refusal exists to prevent.
# EMAIL_TRANSPORT="console"

# Optional: the operator the seed attaches to the pilot venue as its owner, and
# the password it can sign in with at /signin. Dev credentials — change both
# before anything real runs on this database.
SEED_OPERATOR_EMAIL="owner@example.com"
SEED_OPERATOR_PASSWORD="pilot-owner-dev"

# The AI port (PLATFORM.md §6a) — menu extraction from a photo or PDF.
#
# OPTIONAL EVERYWHERE. With no key, development and tests use a deterministic
# mock, and a deployed build simply says photo/PDF reading is unavailable while
# CSV and typed entry keep working — a menu can arrive three other ways, so
# this degrades instead of refusing to boot. AI never decides anything; it
# transcribes what is printed and the operator confirms every line.
ANTHROPIC_API_KEY=""
# Which model reads menus. Transcription, so the cheap tier is the point.
AI_MODEL="claude-haiku-4-5"
# AI_TRANSPORT="mock" forces the fixture extractor — the E2E suite sets this.
# AI_TRANSPORT="mock"

# Authorises the Monday-morning cron route (/api/cron/weekly-report). Vercel
# sends it as `Authorization: Bearer <value>`. Without it the route returns 404
# rather than running open — it emails a venue's P&L, so an unguarded path is a
# venue's numbers available on request.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
