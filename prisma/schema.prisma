// Interlude — wave 1 data model.
// PLATFORM.md §8. Money is stored in paise as integers; never a float.
// `Match` is absent by design: multiplayer is cut from V1.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7: the connection URL lives in prisma.config.ts for CLI/migrate, and
// reaches the client through a driver adapter. It is deliberately not here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Venue, tables, staff
// ---------------------------------------------------------------------------

model Venue {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  timezone       String         @default("Asia/Kolkata")
  /// Per-venue HMAC salt. Makes a cross-venue phone join impossible by
  /// construction (DPDP, PLATFORM.md §7). Never leaves the server.
  phoneSalt      String
  /// The venue QR — one code to print for the counter or the menu. It resolves
  /// to a table picker, which hands off to the per-table `Table.qrToken`,
  /// because arm assignment is per table (PLATFORM.md §3).
  qrToken        String         @unique
  /// Google Place ID for the review deep link.
  googlePlaceId  String?
  /// Onboarding is resumable — nobody sets up a venue in one sitting.
  onboardingStep OnboardingStep @default(DETAILS)
  createdAt      DateTime       @default(now())

  config      VenueConfig?
  tables      Table[]
  menuItems   MenuItem[]
  services    Service[]
  staff       StaffUser[]
  operators   OperatorUser[]
  quizPacks   QuizPack[]
  vetoes      ChefVeto[]
  guestIdents GuestIdentity[]
  guestVisits GuestVisit[]
  prizeRules  PrizeRule[]
  games       VenueGame[]
  posTableMap PosTableMap[]
  history     HistoricalService[]
  menuDraft   MenuImportDraft?
}

/// Every number here is seeded from the business doc's Appendix B estimate and
/// edited per venue in /dash. PLATFORM.md §10 — none of this is a constant.
model VenueConfig {
  id      String @id @default(cuid())
  venueId String @unique
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Round shape.
  //
  // The run is no longer a fixed length. It lasts from the guest starting it
  // until `countdownBufferSec` before the food is due, so a slow kitchen is a
  // longer climb rather than a worse wait — see core/mechanics/climb.ts.
  countdownBufferSec Int @default(60)
  /// Rungs on the ladder. Also the most prizes a single run can put in play.
  climbRungs         Int @default(6)
  /// Seconds a single hand is worth attempting, shown as the per-hand bar.
  climbHandSec       Int @default(25)
  /// Below this much cooking time left, do not offer a run at all.
  climbMinRunSec     Int @default(45)

  /// Deprecated with the trivia quiz the climb replaced. Kept as columns rather
  /// than dropped: a venue that already tuned them loses nothing, and dropping
  /// a column is the one migration that cannot be rolled back cleanly.
  quizLengthSec     Int @default(75)
  quizQuestionCount Int @default(8)
  winThresholdPct   Int @default(70)

  // ── Beat the Kitchen (§4) ────────────────────────────────────────────────
  // Every one of these is an estimate. None is measured. When the pilot
  // returns real numbers, these change and the code does not.

  /// **The pairing rule, and it is load-bearing** (§4.2). A pair is only
  /// eligible when the higher seller outsells the lower by at least this
  /// multiple. There is real money on a wrong answer, and a guest who loses a
  /// dessert on what looks like a coin flip will argue with a server — so every
  /// answer has to be defensible out loud, without hesitation.
  pairGapRatio       Float   @default(2.0)
  /// Trailing window, in days, for the sales counts that ranking comes from.
  velocityWindowDays Int     @default(30)
  /// Rungs on the ladder, and so the most prizes one run can put in play.
  ladderRungs        Int     @default(6)
  /// Runs a table gets before it has to earn more. One per device.
  startingLives      Int     @default(2)
  /// How far a wrong answer drops the table while pushing on (§4.3). There is
  /// no protected floor and no consolation prize.
  gamblePenaltyRungs Int     @default(1)
  /// Each extra-life action, independently disableable (§4.4).
  lifeForAddOn       Boolean @default(true)
  lifeForPhone       Boolean @default(true)
  lifeForFeedback    Boolean @default(true)
  /// Per-question limit. Off for the pilot — the kitchen is the clock (§4.6).
  questionSeconds    Int?
  /// If the floor never fires an order, run untimed rather than not at all. The
  /// game must not depend on staff memory (§10 degradation).
  untimedAfterSec    Int     @default(600)
  /// The zero-kitchen fallback: something the bar pours or the counter hands
  /// over. A pool of nothing must never reach a guest screen (§5).
  fallbackMenuItemId String?

  /// Category -> minutes. Drives the Manual POS adapter's ready estimate,
  /// which takes the *earliest* of the courses fired — see
  /// core/mechanics/prep-estimate.ts.
  prepMinutesByCategory Json @default("{}")
  /// Used when the floor fires without naming courses, which is the one-tap
  /// default on a busy night. The venue's own "how long, typically?" — not a
  /// fallback constant (PLATFORM.md §10).
  defaultPrepMinutes    Int  @default(12)

  /// How this venue ranks its own pool — weights and the thresholds they fire
  /// on. Seeded from DEFAULT_RANKING_WEIGHTS and edited in /dash/prizes. Shape
  /// is core/prize-engine's `RankingWeights`; parsed, never trusted raw.
  rankingWeights Json @default("{\"notSelling\":40,\"slowMover\":25,\"fastMoverPenalty\":-20,\"stale\":15,\"lowPrepBonus\":10,\"highPrepPenalty\":-10,\"slowMoverMaxUnits\":3,\"fastMoverMinUnits\":20,\"staleMinDays\":2}")

  // Prize depth fences
  depthCapPerItemPct      Int @default(100)
  depthCapPerServicePaise Int @default(500000)
  mysteryPlatePricePaise  Int @default(9900)

  // Peak window, minutes from midnight, venue local time
  peakStartMinute Int @default(1140)
  peakEndMinute   Int @default(1380)

  // §11 gates — evaluated in wave 2, configurable from day one
  attachDeltaGatePp     Float @default(5)
  ticketDeltaKillPct    Float @default(4)
  ticketDeltaProceedPct Float @default(6)
  scanRateKillPct       Float @default(15)
  scanRateGoodPct       Float @default(25)
  completionRateGatePct Float @default(60)
  reviewVelocityGateX   Float @default(2)

  // ── Loyalty (§10 — every number an estimate, editable in /dash/prizes) ────
  /// **Off by default, and not out of shyness.** A stamp card changes who comes
  /// back, which is exactly the variable an arm split is measuring — so a venue
  /// running a measurement weekend has to decide to turn it on rather than have
  /// it appear. See TODO.md and docs/DEPLOY.md §7.
  loyaltyEnabled             Boolean @default(false)
  /// Visits since the last rewarded visit that earn the next reward.
  loyaltyVisitsRequired      Int     @default(5)
  /// Ceiling on what one loyalty reward may concede. Composes with, and never
  /// replaces, `depthCapPerItemPct` and `depthCapPerServicePaise`.
  loyaltyRewardMaxValuePaise Int     @default(25000)
  /// An identity untouched this long is pruned by the Monday cron. DPDP storage
  /// limitation: there is no purpose in holding the hash of a number nobody has
  /// used in a year, and holding it is the only harm available.
  loyaltyIdentityExpiryDays  Int     @default(365)

  // ── Review funnel ────────────────────────────────────────────────────────
  /// The venue's own count of Google reviews in a typical week before we
  /// arrived. Operator-entered on /dash/settings, because we do not read Google
  /// and are not going to. Null means velocity is not computed at all.
  reviewsPerWeekBaseline Int?

  updatedAt DateTime @updatedAt
}

/// Which games this venue runs. A row per mechanic rather than flags on
/// VenueConfig: turning a game off mid-service is an operational decision worth
/// a timestamp, and a future mechanic becomes a row rather than a migration.
model VenueGame {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  mechanic     Mechanic
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([venueId, mechanic])
  @@index([venueId, enabled])
}

model Table {
  id      String  @id @default(cuid())
  venueId String
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  label   String
  qrToken String  @unique
  seats   Int     @default(4)
  active  Boolean @default(true)

  armAssignments TableArmAssignment[]
  guestSessions  GuestSession[]
  orderFires     OrderFire[]
  tickets        Ticket[]
  tableRuns      TableRun[]
  posRefs        PosTableMap[]

  @@unique([venueId, label])
  @@index([venueId])
}

model StaffUser {
  id      String    @id @default(cuid())
  venueId String
  venue   Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String
  role    StaffRole
  pinHash String

  orderFires      OrderFire[]
  confirmedAwards Award[]
  kitchenLoads    KitchenLoad[]

  @@index([venueId])
}

/// The owner or F&B head. Two ways in, on purpose: an email magic link
/// (SECURITY.md §7) and an email + password (§7a). The password exists because
/// sending email needs a verified domain that the pilot does not have yet, and
/// it is expected to become the secondary door again once one does.
model OperatorUser {
  id           String       @id @default(cuid())
  /// Null until they finish the first onboarding step. Signing up creates the
  /// person; creating the venue comes after, and may be abandoned halfway.
  venueId      String?
  venue        Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  email        String       @unique
  name         String?
  role         OperatorRole @default(OWNER)
  /// `scrypt:<salt>:<hash>`, the same shape `pin.ts` stores. Null for an
  /// operator created by a magic link, who has never chosen one — so this
  /// being null means "cannot use the password door", never "any password
  /// will do". `operator-password-auth.ts` treats it exactly like a wrong
  /// password, down to still paying the scrypt cost.
  passwordHash String?
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?

  magicLinks MagicLinkToken[]

  @@index([venueId])
}

/// One password sign-in or sign-up attempt from one client IP, for throttling.
///
/// There is deliberately **no email column**. Recording which addresses were
/// guessed at would build exactly the list of operator addresses that
/// SECURITY.md §7 refuses to hand out, and would hand it to anyone who reaches
/// the database — so the throttle is per-IP and stores nothing about who was
/// aimed at (SECURITY.md §7a).
model OperatorLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// A sign-in link is a bearer credential travelling through email, which is not
/// a secure channel. Hashed at rest, single-use, short-lived — SECURITY.md §7.
model MagicLinkToken {
  id              String       @id @default(cuid())
  operatorUserId  String
  operatorUser    OperatorUser @relation(fields: [operatorUserId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token. The token itself is never stored, so a database
  /// dump yields no working sign-in links.
  tokenHash       String       @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime     @default(now())
  /// Rate limiting reads this — a request endpoint that sends unlimited mail
  /// is a free mail cannon pointed at whoever's address is guessed.
  requestedFromIp String?

  @@index([operatorUserId, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Service and the measurement arm
// ---------------------------------------------------------------------------

model Service {
  id          String    @id @default(cuid())
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  /// The service's own date, so a baseline can compare Saturday to Saturday
  /// without deriving a weekday from a timestamp in the wrong timezone.
  serviceDate DateTime  @default(now()) @db.Date
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  /// Denormalised from the latest `ServiceArmAssignment` for cheap reads. The
  /// assignment rows remain the evidence; this is a cache of them, and
  /// `armForService()` is the only thing allowed to write it.
  arm ServiceArm @default(LIVE)

  /// The chef's "this is embarrassing me" button (§7.4). Distinct from RED:
  /// RED is a kitchen state that shapes the pool, this stops offers and awards
  /// outright while the game, the event log and the measurement carry on.
  killedAt   DateTime?
  killedById String?

  armAssignments TableArmAssignment[]
  serviceArms    ServiceArmAssignment[]
  guestSessions  GuestSession[]
  kitchenLoads   KitchenLoad[]
  prizePools     PrizePool[]
  orderFires     OrderFire[]
  tickets        Ticket[]
  tableRuns      TableRun[]
  events         Event[]
  reviewPrompts  ReviewPrompt[]
  venueFeedback  VenueFeedback[]
  guestVisits    GuestVisit[]

  @@index([venueId, startedAt])
  @@index([venueId, serviceDate])
}

/// The evidentiary basis of the business, and the one table that must never be
/// editable after the fact.
///
/// **The service is the unit of assignment, not the table.** Tents go out on
/// every table in a service or on none — a per-table split inside one service
/// contaminates through conversation between tables, and cannot be reconciled
/// with a bill export that only knows the night. This replaces the per-table
/// arm design.
///
/// Append-only. No updates, no deletes: a correction is a **new row** carrying
/// its own reason, and the arm in force is the latest row by `recordedAt`. If
/// this could be edited, so could the result of the pilot.
model ServiceArmAssignment {
  id           String     @id @default(cuid())
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arm          ServiceArm
  /// Why this service is on this arm — "counterbalance: week 2 Saturday live".
  reason       String
  /// Set only on a correction, naming the row being superseded. The original
  /// stays exactly as written.
  supersedesId String?
  recordedAt   DateTime   @default(now())
  recordedBy   String?

  @@index([serviceId, recordedAt])
}

/// **The unit of play.** One per table per service.
///
/// Not the phone. Four people at one table are four `DeviceSession` rows under
/// one run, and every metric in §6.3 is computed over runs unless it says
/// device — counting devices instead would inflate scan rate and deflate
/// completion rate, and both would look like product signal rather than
/// arithmetic.
///
/// The streak lives here rather than on the device because the next person to
/// pick up the game inherits it. That inheritance is the mechanic.
model TableRun {
  id        String  @id @default(cuid())
  tableId   String
  table     Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// Consecutive correct answers standing right now.
  streak         Int      @default(0)
  /// Highest rung the table currently holds. Prizes are taken from here.
  currentRung    Int      @default(0)
  /// Runs still available. Starts at the configured allowance and is spent one
  /// per device; the extra-life actions add to it.
  livesRemaining Int      @default(0)
  /// Pairs already shown to this table, as "loId:hiId" keys. Table-level, not
  /// device-level — the second guest must not be re-asked the first guest's
  /// questions.
  pairsShown     String[] @default([])

  partySize  Int?
  openedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?

  devices       DeviceSession[]
  events        Event[]
  awards        Award[]
  addOns        AddOnRequest[]
  feedback      VenueFeedback[]
  reviewPrompts ReviewPrompt[]
  guestVisits   GuestVisit[]

  @@unique([serviceId, tableId])
  @@index([serviceId, openedAt])
}

/// One phone. Created by a QR scan, identified by an anonymous cookie.
///
/// A device is *spent* once its run ends — that is what forces the table to
/// hand the phone over or earn a life, and it is the most-seen screen on night
/// one (§4.5).
model DeviceSession {
  id         String   @id @default(cuid())
  tableRunId String
  tableRun   TableRun @relation(fields: [tableRunId], references: [id], onDelete: Cascade)

  /// Nothing above this line is written before consent is given (§7.3).
  consentAt  DateTime
  startedAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Set when this device's single run is over. A spent device never plays
  /// again in this service.
  spentAt    DateTime?

  events Event[]

  @@index([tableRunId])
}

/// Append-only funnel log (§6.2). Drop-off location is the entire diagnostic.
///
/// Every metric in §6.3 computes from this table alone, which is why arm and
/// service are denormalised onto each row: a metric that needs a join to know
/// which arm it belongs to will eventually be computed against the wrong one.
model Event {
  id              String         @id @default(cuid())
  type            EventType
  serviceId       String
  service         Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  arm             ServiceArm
  tableRunId      String?
  tableRun        TableRun?      @relation(fields: [tableRunId], references: [id], onDelete: Cascade)
  deviceSessionId String?
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)

  /// Event-specific detail: the pair shown and its gap ratio, which life-earning
  /// action fired, why a run ended. Kept as Json so a new event type does not
  /// need a migration to carry its own context.
  detail Json     @default("{}")
  at     DateTime @default(now())

  @@index([serviceId, at])
  @@index([type, at])
  @@index([tableRunId, at])
}

/// Venue table id to the point-of-sale's own table reference. Without it the
/// bill import cannot join, and an import that cannot join produces no
/// measurement at all (§6.1).
model PosTableMap {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId String
  table   Table  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  /// As it appears in the export. Free text because every POS spells it
  /// differently — "T12", "12", "Table 12".
  posRef  String

  @@unique([venueId, posRef])
  @@index([tableId])
}

/// A menu upload the operator has not confirmed yet (PLATFORM.md §6a).
///
/// The whole point of this row existing is that **nothing reaches `MenuItem`
/// until the operator hits confirm** — an extraction the model got wrong is a
/// draft they edit or discard, never data. One per venue: a new upload
/// replaces the old draft, and confirming or discarding deletes it.
model MenuImportDraft {
  id        String   @id @default(cuid())
  venueId   String   @unique
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// 'csv' | 'photo' | 'pdf' — shown on the grid so the operator knows which
  /// path produced it. Never branches logic.
  source    String
  /// MenuDraftItem[] as JSON. Rupees, not paise — conversion happens once, at
  /// confirm, through the same path typed input takes.
  items     Json
  warnings  Json
  createdAt DateTime @default(now())
}

/// First-party feedback, delivered to the owner (§7.2).
///
/// **Structurally separate from `ReviewPrompt` and it must stay that way.**
/// This one may carry a rating and may grant a life; the Google prompt may do
/// neither. Merging them would create exactly the ability to gate a public
/// review on sentiment that §7.2 exists to make impossible.
model VenueFeedback {
  id          String    @id @default(cuid())
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tableRunId  String?
  tableRun    TableRun? @relation(fields: [tableRunId], references: [id], onDelete: SetNull)
  body        String
  /// Optional, and never read by anything that decides a prize or a review.
  rating      Int?
  submittedAt DateTime  @default(now())

  @@index([serviceId, submittedAt])
}

/// The entire evidentiary basis of the business (PLATFORM.md §8). A recorded
/// row, never a computed guess, and never rewritten — a mid-service swap
/// closes the current row with `effectiveTo` and opens a new one.
model TableArmAssignment {
  id            String    @id @default(cuid())
  serviceId     String
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  arm           Arm
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  /// Why this table is on this arm — "alternating seed, odd label" etc.
  reason        String
  createdAt     DateTime  @default(now())

  guestSessions GuestSession[]

  @@index([serviceId, tableId])
  @@index([tableId, effectiveFrom])
}

// ---------------------------------------------------------------------------
// Menu, kitchen state
// ---------------------------------------------------------------------------

model MenuItem {
  id                  String     @id @default(cuid())
  venueId             String
  venue               Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name                String
  category            String
  pricePaise          Int
  foodCostPaise       Int
  marginTier          MarginTier
  prepBurden          PrepBurden @default(LOW)
  /// If true, awarding this costs the kitchen work — suppressed when load is RED.
  requiresKitchenWork Boolean    @default(true)
  /// Hero items are never discounted (PLATFORM.md §12).
  isHero              Boolean    @default(false)
  active              Boolean    @default(true)
  /// Units sold in the trailing window. **Imported, never guessed** (§4.2) —
  /// this is what decides which of two dishes "more people order here", and a
  /// guessed answer is one a server cannot defend to a guest who just lost a
  /// dessert on it.
  trailingSales       Int        @default(0)
  /// Set when the count came from a real sales export rather than a seed. The
  /// guest-facing question copy changes when it did not: a chef's ranking is
  /// presented as the chef's opinion, never as data.
  salesImportedAt     DateTime?
  /// The chef's own ordering, used only where item-level history is missing.
  /// Lower sorts as more popular.
  chefRank            Int?
  lastSoldAt          DateTime?

  /// Which section fires it. Shown on the pass beside the fire time.
  station     String?
  /// Minutes on the pass for this specific item.
  prepMinutes Int?
  /// A missing photo is a typographic card of the same size and weight, never
  /// a broken image and never a placeholder icon (§10 degradation).
  photoUrl    String?

  vetoes        ChefVeto[]
  awards        Award[]
  addOnRequests AddOnRequest[]

  @@unique([venueId, name])
  @@index([venueId, active])
}

/// The restaurant's own prize policy, as data rather than as our opinion.
///
/// Which items are given away, which are discounted and by how much, and what a
/// losing guest still gets — all of it belongs to the operator (PLATFORM.md
/// §10). Matched **first-match-wins by ascending `priority`**; every null
/// condition means "any". Seeded from `defaultPrizeRules()` at venue creation
/// and editable from `/dash/prizes` immediately after.
///
/// The engine reads these as arguments and stays pure. What a rule cannot do is
/// reach a hero item, override a chef veto, or bust a depth cap — those fences
/// sit above the rule lookup and are tested.
model PrizeRule {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  /// Ascending. Specific rules sort before venue-wide defaults.
  priority Int    @default(100)
  /// The operator's own words. Appears verbatim in the award's audit trail.
  label    String

  mechanic Mechanic
  /// WIN rules set the prize; LOSE rules set the consolation.
  outcome  Outcome

  // --- Conditions. Null means "any". ---
  marginTier MarginTier?
  category   String?
  menuItemId String?
  window     RuleWindow  @default(ANY)

  // --- What it awards ---
  kind            AwardKind
  /// Required when kind is PERCENT_OFF. 1–100.
  percentOff      Int?
  /// Required when kind is FIXED_PRICE. What the guest pays, in paise.
  fixedPricePaise Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, active, priority])
}

model ChefVeto {
  id         String    @id @default(cuid())
  venueId    String
  venue      Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  active     Boolean   @default(true)
  note       String?
  createdAt  DateTime  @default(now())
  clearedAt  DateTime?

  @@unique([menuItemId])
  @@index([venueId, active])
}

model KitchenLoad {
  id        String     @id @default(cuid())
  venueId   String
  serviceId String?
  service   Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  level     LoadLevel
  setAt     DateTime   @default(now())
  setById   String?
  setBy     StaffUser? @relation(fields: [setById], references: [id], onDelete: SetNull)

  @@index([venueId, setAt])
}

/// Per-service snapshot of the prize engine's whole output, entries and
/// exclusions with their `reason` strings. This is the operator's audit trail
/// and the product promise in §14.3 — it is load-bearing, not logging.
model PrizePool {
  id          String    @id @default(cuid())
  serviceId   String
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mechanic    Mechanic
  kitchenLoad LoadLevel
  snapshotAt  DateTime  @default(now())
  /// { itemId, mechanic, depth, reason }[]
  entries     Json
  /// { itemId, reason }[]
  excluded    Json

  awards Award[]

  @@index([serviceId, snapshotAt])
}

// ---------------------------------------------------------------------------
// Guest play
// ---------------------------------------------------------------------------

model GuestSession {
  id              String              @id @default(cuid())
  tableId         String
  table           Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Which arm the table was on at scan time. Denormalised deliberately so a
  /// later swap cannot retroactively change what this session counted as.
  armAssignmentId String?
  armAssignment   TableArmAssignment? @relation(fields: [armAssignmentId], references: [id], onDelete: SetNull)
  armAtScan       Arm

  /// Nothing above this line is written before consent is given.
  consentAt  DateTime
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  plays         Play[]
  addOnRequests AddOnRequest[]
  reviewPrompts ReviewPrompt[]

  @@index([serviceId, startedAt])
  @@index([tableId])
}

model Play {
  id             String       @id @default(cuid())
  guestSessionId String
  guestSession   GuestSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  mechanic       Mechanic
  quizPackId     String?
  quizPack       QuizPack?    @relation(fields: [quizPackId], references: [id], onDelete: SetNull)

  /// Server-issued. The client never decides when the round ends
  /// (PLATFORM.md §11) — clock skew and tab-suspend cannot desync it.
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  completedAt DateTime?

  score    Int      @default(0)
  maxScore Int
  outcome  Outcome?
  /// Ordered question ids + the answer index given, for replay and dispute.
  answers  Json     @default("[]")

  award Award?

  @@index([guestSessionId])
}

model Award {
  id           String    @id @default(cuid())
  /// The run that won it. Nullable because the older per-play awards predate
  /// the table being the unit of play.
  tableRunId   String?
  tableRun     TableRun? @relation(fields: [tableRunId], references: [id], onDelete: Cascade)
  /// Which rung of the ladder this was taken at.
  rung         Int?
  /// Single-use, bound to table and service (§7.4). Short enough to read aloud
  /// across a noisy room, because that is how it will actually be used.
  code         String?   @unique
  redeemedAt   DateTime?
  redeemedById String?

  /// Nullable since the table became the unit of play. `Play` belonged to the
  /// climb, where one device played one round; a Beat the Kitchen award hangs
  /// off the `TableRun` above instead. Kept so climb-era awards still read.
  playId      String?    @unique
  play        Play?      @relation(fields: [playId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem   @relation(fields: [menuItemId], references: [id])
  prizePoolId String?
  prizePool   PrizePool? @relation(fields: [prizePoolId], references: [id], onDelete: SetNull)

  kind            AwardKind
  /// Set when kind is PERCENT_OFF, so the redemption screen can say "40% off"
  /// rather than making the server work it out from two rupee figures.
  percentOff      Int?
  /// Set when kind is FIXED_PRICE — what the guest pays.
  fixedPricePaise Int?
  /// Which `PrizeRule` produced this. Not a foreign key: the rule may be edited
  /// or deleted later, and the award must still say what decided it at the time.
  ruleId          String?
  /// Value conceded to the guest, and what it actually costs the kitchen.
  /// Both snapshotted so a later menu edit cannot rewrite history.
  valuePaise      Int
  foodCostPaise   Int
  /// Why the engine chose this item. Never null — PLATFORM.md §5.
  reason          String

  /// What earned this. Required rather than inferred, because `/dash`'s ledger
  /// renders `Rung ${award.rung ?? run.currentRung}` — so a loyalty award, which
  /// has no rung, would silently be reported as a game result that never
  /// happened. The default backfills every existing row correctly.
  origin     AwardOrigin @default(GAME)
  /// Set when this award was the one a returning guest's stamp paid for.
  guestVisit GuestVisit?

  status        AwardStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   StaffUser?  @relation(fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// How an award was earned. The ledger branches on this rather than on whether
/// `rung` happens to be null.
enum AwardOrigin {
  /// Won on the ladder.
  GAME
  /// Earned by coming back. Not a rung, and never reported as one.
  LOYALTY
}

model AddOnRequest {
  id          String    @id @default(cuid())
  tableRunId  String?
  tableRun    TableRun? @relation(fields: [tableRunId], references: [id], onDelete: Cascade)
  cancelledAt DateTime?
  /// Optional since the table became the unit of play: a Beat the Kitchen
  /// add-on ticket hangs off the TableRun; `GuestSession` rows belong to the
  /// climb era and the current flow never creates one. The server records the
  /// ticket on /floor — the guest asks out loud, which is the point (§4.4).
  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id])
  qty            Int          @default(1)
  /// Snapshotted at request time so the dashboard's money maths is stable.
  pricePaise     Int
  foodCostPaise  Int

  status      AddOnStatus @default(REQUESTED)
  requestedAt DateTime    @default(now())
  ackedAt     DateTime?

  @@index([status, requestedAt])
  @@index([guestSessionId])
}

model OrderFire {
  id         String     @id @default(cuid())
  tableId    String
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  firedAt    DateTime   @default(now())
  /// Server-computed from the venue's configured prep minutes.
  estReadyAt DateTime
  /// Menu categories this fire covered, as the floor reported them. Empty means
  /// the server fired without naming courses and the estimate used
  /// `defaultPrepMinutes`. Recorded because the estimate is a guess we will want
  /// to check against a real service once bill exports land in wave 2.
  courses    String[]   @default([])
  /// Captured in the same tap that fires the order (§3). Spend per table is
  /// dominated by how many people are sitting at it, so without this the spend
  /// comparison is noise — which is why it is mandatory rather than nice to
  /// have. Nullable only so a legacy row does not lie about having one.
  partySize  Int?
  firedById  String?
  firedBy    StaffUser? @relation(fields: [firedById], references: [id], onDelete: SetNull)

  @@index([serviceId, firedAt])
  @@index([tableId, firedAt])
}

// ---------------------------------------------------------------------------
// Quiz content
// ---------------------------------------------------------------------------

model QuizPack {
  id      String  @id @default(cuid())
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String
  active  Boolean @default(true)

  questions QuizQuestion[]
  plays     Play[]
}

model QuizQuestion {
  id          String   @id @default(cuid())
  packId      String
  pack        QuizPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  prompt      String
  /// string[] — rendered in order.
  options     Json
  answerIndex Int
  difficulty  Int      @default(1)
  orderHint   Int      @default(0)

  @@index([packId, orderHint])
}

// ---------------------------------------------------------------------------
// Wave 2 / wave 3 — modelled now so neither needs a migration later
// ---------------------------------------------------------------------------

/// Closed bill lines from the venue's end-of-day POS export (CSV). Wave 2.
/// One imported bill (§6.1).
///
/// `tableId` is null when the export's table reference did not resolve through
/// `PosTableMap`. **Unjoinable rows are surfaced for manual mapping, never
/// silently dropped** (§6.5) — a silent drop is a biased dataset, and it biases
/// in the direction of whichever tables the POS happens to name oddly.
model Ticket {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tableId     String?
  table       Table?   @relation(fields: [tableId], references: [id], onDelete: SetNull)
  /// The table reference exactly as the export spelled it, kept even after a
  /// successful join so a mis-mapping can be found later.
  posRef      String?
  externalRef String
  closedAt    DateTime
  totalPaise  Int
  /// Heads on the bill. Spend per cover is the primary figure (§3), so a bill
  /// without covers can only contribute to the secondary one.
  covers      Int?
  /// { name, qty, pricePaise }[] as exported. Parsed, never trusted.
  lines       Json
  importedAt  DateTime @default(now())

  @@unique([serviceId, externalRef])
  @@index([serviceId, closedAt])
  @@index([serviceId, tableId])
}

/// A pre-launch service imported from the venue's own history, so Saturday can
/// be compared to Saturday without spending a live service on a control (§3).
///
/// This is the **primary** comparison. The counterbalanced live services are
/// secondary, and scanners-versus-non-scanners is diagnostic only.
model HistoricalService {
  id                 String   @id @default(cuid())
  venueId            String
  venue              Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  serviceDate        DateTime @db.Date
  /// 0 = Sunday, matching `Date.getUTCDay`. Stored rather than derived so a
  /// timezone change cannot silently re-bucket a night.
  weekday            Int
  covers             Int
  tableCount         Int
  totalPaise         Int
  /// Bills carrying at least one dessert or beverage line, for attach rate.
  attachedTableCount Int      @default(0)
  importedAt         DateTime @default(now())

  @@unique([venueId, serviceDate])
  @@index([venueId, weekday])
}

/// Funnel counts only — shown, drafted, handed off. No rating is stored, ever,
/// because storing sentiment would create the ability to gate on it
/// (PLATFORM.md §7). This model must never reference Award or PrizePool.
/// Funnel counts only: shown, opened, handed off. **No rating, ever** (§7.2).
///
/// The absence of a rating column is the enforcement, not a convention. If
/// sentiment were stored here it would become possible to gate a public review
/// on it, and Google's penalty for that lands on the restaurant's Business
/// Profile — which is most of a Delhi restaurant's discovery. The harm would
/// fall on the customer, not on us.
///
/// First-party sentiment lives in `VenueFeedback`, which is a different table
/// reached by a different module on a different screen.
model ReviewPrompt {
  id             String        @id @default(cuid())
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Climb-era rows hang off a GuestSession; the table is the unit now, so new
  /// rows hang off the TableRun instead. One of the two is always set.
  guestSessionId String?
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  /// Unique so `shownAt` and `openedAt` can be written by two different screens
  /// as idempotent upserts — the guest page stamps "shown" when the entry link
  /// renders, the review screen stamps "opened". Nullable, and Postgres does not
  /// conflict nulls, so the climb-era `guestSessionId` rows are unaffected.
  tableRunId     String?       @unique
  tableRun       TableRun?     @relation(fields: [tableRunId], references: [id], onDelete: Cascade)
  shownAt        DateTime      @default(now())
  openedAt       DateTime?
  draftedAt      DateTime?
  handedOffAt    DateTime?

  @@index([shownAt])
}

/// Phone stored only as an HMAC with the venue's own salt. No cross-venue join
/// is possible in V1 by construction (DPDP, SECURITY.md §6).
model GuestIdentity {
  id          String       @id @default(cuid())
  venueId     String
  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  phoneHmac   String
  /// A cache of `count(visits)`, written in the same transaction — exactly the
  /// way `Service.arm` caches the arm assignment. **The rows are the evidence.**
  /// Nothing decides a reward from this column; it exists so a screen can show
  /// a number without a count query.
  visitCount  Int          @default(1)
  firstSeenAt DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())
  visits      GuestVisit[]

  @@unique([venueId, phoneHmac])
  /// The expiry sweep reads this.
  @@index([venueId, lastSeenAt])
}

/// One stamp on the card, and the loyalty ledger.
///
/// `GuestIdentity.visitCount` alone cannot carry this. A single mutable integer
/// cannot be **idempotent** (there is no key to conflict on, and a
/// select-then-update guard is a race under polling), cannot be **audited**
/// ("why did table 7 get a free kulfi?" has no answer), and cannot be **erased**
/// row by row for a DPDP request.
///
/// **Keyed on the service, not the table run.** A `TableRun` is unique per
/// (service, table), so a guest who moved tables — or simply walked to an empty
/// one and typed their number again — would earn two stamps for one night. The
/// service is the night, and the night is the visit.
model GuestVisit {
  id              String        @id @default(cuid())
  guestIdentityId String
  guestIdentity   GuestIdentity @relation(fields: [guestIdentityId], references: [id], onDelete: Cascade)
  /// Denormalised so a per-venue read needs no join, the same reason `Event`
  /// carries `arm` and `serviceId`.
  venueId         String
  venue           Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// The run the phone was on when the number was left. Nullable so an
  /// out-of-band stamp cannot lie about having one.
  tableRunId      String?
  tableRun        TableRun?     @relation(fields: [tableRunId], references: [id], onDelete: SetNull)
  /// The ordinal at the moment it was written, snapshotted. Recomputing it later
  /// against a config edited since would answer a different question.
  visitNumber     Int
  /// Set only when this stamp is the one that crossed the threshold. Most
  /// visits reward nothing, and that is the normal case.
  awardId         String?       @unique
  award           Award?        @relation(fields: [awardId], references: [id], onDelete: SetNull)
  recordedAt      DateTime      @default(now())

  /// The idempotency, at the database rather than in a guard. Two phones typing
  /// the same number at one table is one visit.
  @@unique([guestIdentityId, serviceId])
  @@index([venueId, recordedAt])
}

// ---------------------------------------------------------------------------

enum Arm {
  TREATMENT
  CONTROL
}

/// The service-level arm. `LIVE` means tents went out on every table that
/// night; `CONTROL` means none did.
enum ServiceArm {
  LIVE
  CONTROL
}

/// §6.2, in the order a night actually produces them. Append-only in spirit:
/// removing a member rewrites history that has already been logged.
enum EventType {
  TENT_PRESENT
  SESSION_OPEN
  CONSENT_GIVEN
  RUN_START
  PAIR_SHOWN
  ANSWER
  RUNG_REACHED
  GAMBLE_TAKEN
  GAMBLE_DECLINED
  RUN_END
  DEVICE_SPENT
  LIFE_EARNED
  PRIZE_TAKEN
  ADDON_REQUESTED
  ADDON_CONFIRMED
  ADDON_CANCELLED
  PHONE_SUBMITTED
  FEEDBACK_SUBMITTED
  AWARD_REDEEMED
  AWARD_EXPIRED
  REVIEW_SHOWN
  REVIEW_OPENED
  REVIEW_HANDED_OFF
  /// A returning guest left their number and earned a stamp. Carries the visit
  /// number and never the number itself.
  LOYALTY_STAMPED
  /// A stamp crossed the threshold and an award was written.
  LOYALTY_REWARDED
  /// A guest asked for their identity to be deleted. Carries a count, nothing else.
  PHONE_ERASED
}

/// Why a run ended.
///
/// `FOOD_ARRIVED` is a success wearing a failure's clothes and must never be
/// counted with `ABANDONED`: conflating them makes completion rate look broken
/// while the product is working exactly as designed (§6.2).
enum RunEndReason {
  WRONG_ANSWER
  FOOD_ARRIVED
  ABANDONED
  TIMEOUT
  PRIZE_TAKEN
}

/// The three actions that buy a table another run (§4.4). Each is independently
/// disableable per venue.
enum LifeAction {
  ADDON_CONFIRMED
  PHONE_SUBMITTED
  FEEDBACK_SUBMITTED
}

enum StaffRole {
  SERVER
  KITCHEN
}

enum MarginTier {
  HIGH
  MID
  LOW
}

enum PrepBurden {
  LOW
  MEDIUM
  HIGH
}

enum LoadLevel {
  GREEN
  AMBER
  RED
}

enum Mechanic {
  /// Beat the Kitchen — higher-or-lower on the venue's own menu (§4). The one
  /// game that ships. `KITCHEN_ROUND` is its predecessor and is kept only so
  /// already-logged rows still read.
  BEAT_THE_KITCHEN
  KITCHEN_ROUND
  MYSTERY_PLATE
}

enum Outcome {
  WIN
  LOSE
}

/// `HALF_PRICE` used to live here and is gone: it was a hardcoded 50, which is
/// exactly the kind of venue number PLATFORM.md §10 forbids baking into code.
/// A half-price prize is now `PERCENT_OFF` with `percentOff = 50`, set by the
/// venue and editable by them.
enum AwardKind {
  FREE
  PERCENT_OFF
  FIXED_PRICE
}

enum RuleWindow {
  ANY
  PEAK
  OFF_PEAK
}

enum OperatorRole {
  OWNER
  MANAGER
}

/// The wizard's cursor. `STAFF` is a screen that shows the PINs rather than one
/// that asks for them — a venue that cannot open a service is not set up, so the
/// PINs are generated with the venue and the operator is only shown them.
enum OnboardingStep {
  DETAILS
  TABLES
  MENU
  STAFF
  QR
  GAMES
  DONE
}

enum AwardStatus {
  PENDING
  CONFIRMED
  EXPIRED
}

enum AddOnStatus {
  REQUESTED
  ACKED
  CANCELLED
}
